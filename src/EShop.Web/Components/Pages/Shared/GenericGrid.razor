@using MudBlazor
@typeparam TItem

<MudDataGrid 
            T="TItem"
             @ref="_grid"
             ServerData="OnServerData"
             Filterable="true"
             Sortable="true"
             Hover="true"
             Bordered="true"
             Dense="true"
             RowsPerPage="@DefaultPageSize">

    <ToolBarContent>
        <MudItem xs="12" sm="6">
            <MudTextField Value="_searchText"
                            ValueChanged="@((string value) => OnSearchChanged(value))"
                            Placeholder="@SearchPlaceholder"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Search"
                            Class="mb-4"
                            Immediate="true"
                            DebounceInterval="300" />
          
        </MudItem>
        @if(ShowAddButton){
            <MudItem xs="12" sm="6" Class="d-flex justify-end">
                <MudButton onclick="OnAddClicked" Color="Color.Success" Variant="Variant.Filled">
                    @AddButtonText
                </MudButton>
            </MudItem>
        }
    </ToolBarContent>

    <Columns>
        @Columns

        @if (ShowActions)
        {
            <TemplateColumn T="TItem">
                <HeaderTemplate>Actions</HeaderTemplate>
                <CellTemplate Context="cellContext">
                    @{
                        var item = cellContext.Item;
                    }

                    @if (OnEdit.HasDelegate)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                        Size="Size.Small"
                                        OnClick="@(() => OnEdit.InvokeAsync(item))" />
                    }

                    @if (OnDelete.HasDelegate)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                        Color="Color.Error"
                                        Size="Size.Small"
                                        OnClick="@(() => OnDelete.InvokeAsync(item))" />
                    }
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>

    <PagerContent>
        <MudDataGridPager T="TItem" PageSizeOptions="@PageSizeOptions" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter]
    public Func<GridState<TItem>, string?, Task<GridData<TItem>>> ServerData { get; set; } = default!;

    [Parameter] public RenderFragment? Columns { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = new[] { 10, 25, 50 };
    [Parameter] public int DefaultPageSize { get; set; } = 5;
    [Parameter] public string SearchPlaceholder { get; set; } = "Search";
    [Parameter] public bool ShowAddButton { get; set; } = false;
    [Parameter] public string AddButtonText { get; set; } = "Add";
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public bool ShowActions { get; set; } = false;
    [Parameter] public EventCallback<TItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }

    private MudDataGrid<TItem>? _grid;
    private string _searchText = string.Empty;

    private Task<GridData<TItem>> OnServerData(GridState<TItem> state)
        => ServerData(state, _searchText);

    private async Task OnSearchChanged(string value)
    {
        _searchText = value;

        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task OnAddClicked()
    {
        if (OnAdd.HasDelegate)
            await OnAdd.InvokeAsync();
    }

    public Task ReloadAsync()
    {
        return _grid?.ReloadServerData() ?? Task.CompletedTask;
    }
}
