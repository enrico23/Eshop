@page "/categories"
@using EShop.Web.Components.Pages.Categories
@using EShop.Web.Components.Pages.Shared
@using EShop.Web.Exceptions
@using EShop.Web.Models
@using Microsoft.AspNetCore.Authorization
@inherits CrudPageBase
@attribute [Authorize]

<MudPaper Class="pa-4">
    <GenericGrid TItem="CategoryDto"
                @ref="_grid"
                ServerData="LoadCategoryAsync"
                DefaultPageSize="10"
                PageSizeOptions="new[] {5, 10, 25, 50 }"
                SearchPlaceholder="Search..."
                ShowAddButton="true"
                AddButtonText="Add Category"
                OnAdd="OpenCreateDialogAsync"
                ShowActions="true"
                OnEdit="OpenEditDialogAsync"
                OnDelete="OpenDeleteDialogAsync">
        <Columns>
            <PropertyColumn 
                T="CategoryDto"
                TProperty="string"
                Property="x => x.Name" 
                Sortable="true" />
            <TemplateColumn T="CategoryDto">
                <HeaderTemplate>Image</HeaderTemplate>
                <CellTemplate Context="cellContext">
                    @{
                        var img = GetPrimaryOrFirstImage(cellContext.Item);
                        var editUrl = $"/categories/{cellContext.Item.Id}/edit";
                    }
                    
                    <div class="img-frame img-frame--thumb">
                        <MudLink Href="@editUrl">
                            <div class="img-frame img-frame--thumb">
                                @if (img is not null)
                                {
                                    <img src="@GetImageUrl(img.Url)" alt="@img.AltText" class="img-cover" />
                                }
                                else
                                {
                                    <div class="img-placeholder">No image</div>
                                }
                            </div>
                        </MudLink>
                    </div>
                </CellTemplate>

            </TemplateColumn>
        </Columns>
    </GenericGrid>
</MudPaper>

@code {
    [Inject] protected ICatalogApiClient CatalogApiClient { get; set; } = null!;

    [Inject] protected ApiClientConfig ApiClientConfig { get; set; } = null!;

    private GenericGrid<CategoryDto>? _grid;

    private async Task<GridData<CategoryDto>> LoadCategoryAsync(GridState<CategoryDto> state, string? searchText)
        => await LoadGridAsync(
            state,
            searchText,
            defaultSortBy: "Name",
            loadPage: (page, pageSize, sortBy, sortDir, search, ct) =>
                CatalogApiClient.GetPagedCategoriesAsync(page, pageSize, sortBy, sortDir, search, ct),
            cancellationToken: CancellationToken.None);

    private async Task OpenCreateDialogAsync() => 
        NavigationManager.NavigateTo("/categories/create");

    private async Task OpenEditDialogAsync(CategoryDto existing) =>
        NavigationManager.NavigateTo($"/categories/{existing.Id}/edit");
    

    private async Task OpenDeleteDialogAsync(CategoryDto item)
    {
        var deleted = await ConfirmDeleteAsync(
            title: "Delete Category",
            message: $"Are you sure you want to delete the category '{item.Name}'?",
            deleteAction: ct => CatalogApiClient.DeleteCategoryAsync(item.Id, ct),
            successMessage: $"Category '{item.Name}' deleted successfully.");

        if (deleted && _grid is not null)
            await _grid.ReloadAsync();
    }

    private static CatalogImageDto? GetPrimaryOrFirstImage(CategoryDto item)
    {
        if (item.Images is null || item.Images.Count == 0)
            return null;

        return item.Images.FirstOrDefault(i => i.IsPrimary)
            ?? item.Images.OrderBy(i => i.SortOrder).First();
    }

    private string GetImageUrl(string url) => $"{ApiClientConfig.BaseUrl}/api/images/{url}?purpose=Categories";
}
