@page "/categories"
@using EShop.Web.Components.Pages.Categories
@using EShop.Web.Components.Pages.Shared
@using EShop.Web.Exceptions
@inherits CrudPageBase

<MudPaper Class="pa-4">
    <GenericGrid TItem="CategoryDto"
                @ref="_grid"
                ServerData="LoadCategoryAsync"
                DefaultPageSize="10"
                PageSizeOptions="new[] {5, 10, 25, 50 }"
                SearchPlaceholder="Search..."
                AddButtonText="Add Category"
                OnAdd="OpenCreateDialogAsync"
                OnEdit="OpenEditDialogAsync"
                OnDelete="OpenDeleteDialogAsync">
        <Columns>
            <PropertyColumn 
                T="CategoryDto"
                TProperty="string"
                Property="x => x.Name" 
                Sortable="true" />
        </Columns>
    </GenericGrid>
</MudPaper>

@code {
    [Inject] protected ICatalogApiClient CatalogApiClient { get; set; } = null!;

    private GenericGrid<CategoryDto>? _grid;

    private async Task<GridData<CategoryDto>> LoadCategoryAsync(GridState<CategoryDto> state, string? searchText)
    => await LoadGridAsync(
            state,
            searchText,
            defaultSortBy: "Name",
            loadPage: (page, pageSize, sortBy, sortDir, search, ct) =>
                CatalogApiClient.GetPagedCategoriesAsync(page, pageSize, sortBy, sortDir, search, ct),
            cancellationToken: CancellationToken.None);

    private async Task OpenCreateDialogAsync()
    {
        var createCategoryDto = new CreateCategoryDto { Name = string.Empty };
        var dialogParameters = new DialogParameters
        {
            ["Category"] = createCategoryDto
        };

        var (saved, returned) = await ShowUpsertDialogAsync<CategoryUpsertDialog, CreateCategoryDto>(
            title: "Create Category",
            parameters: dialogParameters);

        if (!saved || returned is null || _grid is null) return;

        var ok = await SaveWithFeedbackAsync(
            returned,
            saveAction: (m, ct) => 
            CatalogApiClient.CreateCategoryAsync(new CreateCategoryDto { Name = m.Name }, ct),
            successMessageFactory: m => $"Category '{m.Name}' successfully created.");

        if (ok) await _grid.ReloadAsync();
    }

    private async Task OpenEditDialogAsync(CategoryDto existing)
    {
        var updateCategoryDto = new UpdateCategoryDto { Name = existing.Name };

        var parameters = new DialogParameters
        {
            ["Category"] = updateCategoryDto
        };

        var (saved, returned) = await ShowUpsertDialogAsync<CategoryUpsertDialog, UpdateCategoryDto>(
            title: "Update Category",
            parameters: parameters);

        if (!saved || returned is null || _grid is null) return;

        var ok = await SaveWithFeedbackAsync(
            returned,
            saveAction: (m, ct) => CatalogApiClient.UpdateCategoryAsync(
                existing.Id,
                new UpdateCategoryDto { Name = m.Name, },
                ct),
            successMessageFactory: m => $"Category '{m.Name}' successfully updated.");

        if (ok) await _grid.ReloadAsync();
    }

    private async Task OpenDeleteDialogAsync(CategoryDto item)
    {
        var deleted = await ConfirmDeleteAsync(
            title: "Delete Category",
            message: $"Are you sure you want to delete the category '{item.Name}'?",
            deleteAction: ct => CatalogApiClient.DeleteCategoryAsync(item.Id, ct),
            successMessage: $"Category '{item.Name}' deleted successfully.");

        if (deleted && _grid is not null)
            await _grid.ReloadAsync();
    }
}
