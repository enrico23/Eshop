@page "/categories"
@using EShop.Web.Components.Pages.Categories
@using EShop.Web.Components.Pages.Shared
@using EShop.Web.Exceptions
@inherits BaseCrudPage

<MudPaper Class="pa-4">
    <GenericGrid TItem="CategoryDto"
                 @ref="_grid"
                 ServerData="LoadCategoryAsync"
                 DefaultPageSize="10"
                 PageSizeOptions="new[] {5, 10, 25, 50 }"
                 SearchPlaceholder="Search..."
                 AddButtonText="Add Category"
                 OnAdd="OpenCreateDialogAsync"
                 OnEdit="OpenEditDialogAsync"
                 OnDelete="OpenDeleteDialogAsync">
        <Columns>
            <PropertyColumn 
                T="CategoryDto"
                TProperty="string"
                Property="x => x.Name" 
                Sortable="true" />
        </Columns>
    </GenericGrid>
</MudPaper>

@code {
    private GenericGrid<CategoryDto>? _grid;

    private async Task<GridData<CategoryDto>> LoadCategoryAsync(GridState<CategoryDto> state, string? searchText)
    {
        var sortBy = "Name";
        var sortDirection = "asc";
        var currentPage = state.Page;
        var pageSize = state.PageSize;

        var sortDefinition = state.SortDefinitions.FirstOrDefault();
        if (sortDefinition != null)
        {
            sortBy = sortDefinition.SortBy;
            sortDirection = sortDefinition.Descending ? "desc" : "asc";
        }

        var page = currentPage + 1;

        try
        {
            var pagedData = await CategoryApiClient.GetPagedCategoriesAsync(page, pageSize, sortBy, sortDirection, searchText, CancellationToken.None);

            return new GridData<CategoryDto>
            {
                TotalItems = pagedData!.Total,
                Items = pagedData.Items
            };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.FriendlyMessage!, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unexpected error.", Severity.Error);
        }

        return new GridData<CategoryDto>
        {
            TotalItems = 0,
            Items = new List<CategoryDto>()
        };
    }

    private async Task OpenCreateDialogAsync()
    {
        var createCategoryDto = new CreateCategoryDto { Name = string.Empty };

        var parameters = new DialogParameters
        {
            ["Category"] = createCategoryDto
        };

        var saved = await ConfirmUpsertAsync<CategoryUpsertDialog, CreateCategoryDto>(
           title: "Create Category",
           parameters: parameters,
           saveAction: model => CategoryApiClient.CreateCategoryAsync(model, CancellationToken.None),
           successMessage: $"Category '{createCategoryDto.Name}' successfully created");


        if (saved && _grid is not null)
            await _grid.ReloadAsync();
    }

    private async Task OpenEditDialogAsync(CategoryDto existing)
    {
        var updateCategoryDto = new UpdateCategoryDto { Name = existing.Name };

        var parameters = new DialogParameters
        {
            ["Category"] = updateCategoryDto
        };
        var saved = await ConfirmUpsertAsync<CategoryUpsertDialog, UpdateCategoryDto>(
           title: "Update Category",
           parameters: parameters,
           saveAction: model => CategoryApiClient.UpdateCategoryAsync(existing.Id, model, CancellationToken.None),
           successMessage: $"Category '{updateCategoryDto.Name}' successfully created");

        if (saved && _grid is not null)
            await _grid.ReloadAsync();

    }

    private async Task OpenDeleteDialogAsync(CategoryDto item)
    {
        var deleted = await ConfirmDeleteAsync<CategoryDto>(
            item,
            title: "Delete category",
            message: $"Are you sure you want to delete category '{item.Name}'?",
            deleteAction: action => CategoryApiClient.DeleteCategoryAsync(item.Id)
        );

        if (deleted && _grid is not null)
                 await _grid.ReloadAsync();
    }
}
