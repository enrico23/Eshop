@page "/categories"
@using EShop.Web.Components.Pages.Categories
@using EShop.Web.Exceptions

<MudPaper Class="pa-4">
    <GenericGrid TItem="CategoryDto"
                 @ref="_grid"
                 ServerData="LoadCategoryAsync"
                 DefaultPageSize="10"
                 PageSizeOptions="new[] {5, 10, 25, 50 }"
                 SearchPlaceholder="Search..."
                 AddButtonText="Add Category"
                 OnAdd="OpenCreateDialogAsync"
                 OnEdit="OpenEditDialogAsync"
                 OnDelete="OpenDeleteDialogAsync">
        <Columns>
            <PropertyColumn 
                T="CategoryDto"
                TProperty="string"
                Property="x => x.Name" 
                Sortable="true" />
        </Columns>
    </GenericGrid>
</MudPaper>

@code {
    [Inject] protected ICatalogApiClient CategoryApiClient { get; set; } = null!;
    [Inject] protected IDialogService DialogService { get; set; } = null!;
    [Inject] protected ISnackbar Snackbar { get; set; } = null!;

    private GenericGrid<CategoryDto>? _grid;

    private async Task<GridData<CategoryDto>> LoadCategoryAsync(GridState<CategoryDto> state, string? searchText)
    {
        var sortBy = "Name";
        var sortDirection = "asc";
        var currentPage = state.Page;
        var pageSize = state.PageSize;

        var sortDefinition = state.SortDefinitions.FirstOrDefault();
        if (sortDefinition != null)
        {
            sortBy = sortDefinition.SortBy;
            sortDirection = sortDefinition.Descending ? "desc" : "asc";
        }

        var page = currentPage + 1;

        try
        {
            var pagedData = await CategoryApiClient.GetPagedCategoriesAsync(page, pageSize, sortBy, sortDirection, searchText, CancellationToken.None);

            return new GridData<CategoryDto>
            {
                TotalItems = pagedData!.Total,
                Items = pagedData.Items
            };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.FriendlyMessage!, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unexpected error.", Severity.Error);
        }

        return new GridData<CategoryDto>
        {
            TotalItems = 0,
            Items = new List<CategoryDto>()
        };
    }

    private DialogOptions _options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private async Task OpenCreateDialogAsync()
    {
        var createCategoryDto = new CreateCategoryDto { Name = string.Empty };

        var parameters = new DialogParameters
        {
            ["Category"] = createCategoryDto,
            ["OnSave"] = new Func<CategoryUpsertDto, Task>(async dto =>
            {
                var createDto = (CreateCategoryDto)dto;
                await CategoryApiClient.CreateCategoryAsync(createDto, CancellationToken.None);
            })
        };

        var dialog = await DialogService.ShowAsync<CategoryUpsertDialog>("Add Category", parameters, _options);
        var result = await dialog.Result;

        if (result!.Canceled != true)
        {
            var created = (CreateCategoryDto)result.Data!;
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Category '{created.Name}' succesfully created", Severity.Success);

            if (_grid is not null)
                await _grid.ReloadAsync();
        }
    }

    private async Task OpenEditDialogAsync(CategoryDto existing)
    {
        var updateCategoryDto = new UpdateCategoryDto { Name = existing.Name };

        var parameters = new DialogParameters
        {
            ["Category"] = updateCategoryDto,
            ["OnSave"] = new Func<CategoryUpsertDto, Task>(async dto =>
            {
                var updateDto = (UpdateCategoryDto)dto;
                await CategoryApiClient.UpdateCategoryAsync(existing.Id, updateDto, CancellationToken.None);
            })
        };
        var dialog = await DialogService.ShowAsync<CategoryUpsertDialog>("Edit category", parameters, _options);
        var result = await dialog.Result;

        if (result!.Canceled != true)
        {
            var updated = (UpdateCategoryDto)result.Data!;
            Snackbar.Add($"Category '{updated.Name}' succesfully updated", Severity.Info);

            if (_grid is not null)
                await _grid.ReloadAsync();
        }
    }

    private async Task OpenDeleteDialogAsync(CategoryDto item)
    {
        var parameters = new DialogParameters { ["CategoryParam"] = item };
        var dialog = await DialogService.ShowAsync<DeleteCategoryDialog>($"Delete Category", parameters, _options);
        var result = await dialog.Result;

        if (result!.Canceled != true)
        {
            Snackbar.Add($"Category '{item.Name}' succesfully deleted!", Severity.Success);
            if (_grid is not null)
                await _grid.ReloadAsync();
        }
    }

}
