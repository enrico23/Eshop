@using EShop.Shared.Representations.Category
@using EShop.Web.Clients
@using EShop.Web.Exceptions
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Edit Category</MudText>

        <MudForm @ref="mudForm">
            <MudTextField @bind-Value="EditModel.Name"
                            Label="Name"
                            Required="true"
                            For="@(() => EditModel.Name)" />
        </MudForm>

        @if (!string.IsNullOrEmpty(ServerError))
        {
            <MudText Color="Color.Error" Class="mt-2">@ServerError</MudText>
        }

    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="SubmitForm">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject] CategoryApiClient CategoryApiClient { get; set; } = null!;

    [Parameter] public CategoryDto? CategoryParam { get; set; }

    private MudForm mudForm = null!;

    private UpdateCategoryDto EditModel { get; set; } = new() { Name = string.Empty };

    private string ServerError = string.Empty;
    private int categoryId;

    protected override void OnInitialized()
    {
        if (CategoryParam != null)
        {
            categoryId = CategoryParam.Id;
            EditModel = new UpdateCategoryDto { Name = CategoryParam.Name };
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitForm()
    {
        ServerError = string.Empty;
        await mudForm.Validate();

        try
        {
            await CategoryApiClient.UpdateAsync(categoryId, EditModel);
            
            MudDialog.Close(DialogResult.Ok(EditModel));
        }
        catch (Exception ex)
        {
            ServerError = ex.Message;
        }
    }
}
