@using MudBlazor
@inherits ComponentBase

<MudGrid GutterSize="2">

    <MudItem xs="12">
        <MudTextField @bind-Value="Category.Name"
                      Label="Name"
                      Required="true"
                      For="@(() => Category.Name)" />
    </MudItem>

</MudGrid>

@code {
    [Parameter]
    public CategoryUpsertDto Category { get; set; } = null!;
}
