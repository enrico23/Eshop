@using EShop.Shared.Representations.Category
@using EShop.Web.Clients
@using System.Threading.Tasks

<MudDialog>
    <DialogContent>
        <MudText>Are you sure that you want to delete the category '@categoryName'?</MudText>

        @if (!string.IsNullOrEmpty(ServerError))
        {
            <MudSpacer />
            <MudText Color="Color.Error" Class="mt-2">@ServerError</MudText>
        }

        @if (IsSubmitting)
        {
            <MudSpacer />
            <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true" />
        }

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Submit" Disabled="@IsSubmitting">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] 
    public CategoryDto? CategoryParam { get; set; }

    [Parameter]
    public CancellationToken CancellationToken { get; set; }

    private string ServerError = string.Empty;

    private bool IsSubmitting = false;

    private int categoryId;

    private string categoryName = string.Empty;

    [Inject] ICategoryApiClient CategoryApiClient { get; set; } = null!;

    protected override void OnInitialized()
    {
        if (CategoryParam != null)
        {
            categoryId = CategoryParam.Id;
            categoryName = CategoryParam.Name;
        }
    }

    private async Task Submit() 
    {
        IsSubmitting = true;

        try
        {
            await CategoryApiClient.DeleteAsync(categoryId, CancellationToken);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            ServerError = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}