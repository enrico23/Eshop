@page "/"
@rendermode InteractiveServer
@inherits HomeBase

<main id="main">
    <section class="hero" aria-labelledby="hero-title">
        <div class="container">
            <div class="row align-center">
                <div class="col col-12 col-lg-6">
                    <p class="eyebrow">Precision Series</p>
                    <h1 id="hero-title">Minimal design. Maximum presence.</h1>
                    <p class="subhead">
                        Crafted for quiet power and refined everyday rituals. A storefront that
                        feels premium without the noise.
                    </p>
                    <div class="hero-actions">
                        <a class="button button-primary" href="#products">Shop the line</a>
                        <a class="text-link" href="#featured">Explore the collection</a>
                    </div>
                </div>
                <div class="col col-12 col-lg-6">
                    <div class="hero-visual" role="img" aria-label="Product visual placeholder">
                        <svg viewBox="0 0 520 420" aria-hidden="true">
                            <defs>
                                <linearGradient id="g1" x1="0" x2="1" y1="0" y2="1">
                                    <stop offset="0%" stop-color="#f2f4f7" />
                                    <stop offset="100%" stop-color="#dfe3ea" />
                                </linearGradient>
                            </defs>
                            <rect x="32" y="24" width="456" height="300" rx="32" fill="url(#g1)" />
                            <rect x="96" y="282" width="328" height="76" rx="22" fill="#ffffff" opacity="0.9" />
                            <circle cx="170" cy="320" r="24" fill="#cfd6df" />
                            <rect x="212" y="304" width="188" height="32" rx="16" fill="#e7ecf2" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CATEGORY TILES -->
    <section class="category-rail">
        <div class="container">
            <div class="rail-wrap">
                <MudIconButton id="category-rail-left"
                               Icon="@Icons.Material.Filled.ChevronLeft"
                               Class="rail-nav rail-nav-left"
                               OnClick="() => ScrollCategoriesByAsync(-1)"
                               AriaLabel="Scroll categories left" />
                <div id="category-rail-track" class="category-rail-track" role="list" @ref="_categoryRailRef">
                    @foreach (var c in _categories)
                    {
                        <div class="category-rail-item" role="listitem">
                            <MudPaper Elevation="0" Class="category-tile category-tile--rail"
                                      @onclick="() => SelectCategory(c.Id)">
                                <MudStack Spacing="0" Class="category-inner">
                                    @* <MudIcon Icon="@c.Icon" /> *@
                                    <MudText Typo="Typo.subtitle2">@c.Name</MudText>
                                </MudStack>
                            </MudPaper>
                        </div>
                    }
                </div>
                <MudIconButton id="category-rail-right"
                               Icon="@Icons.Material.Filled.ChevronRight"
                               Class="rail-nav rail-nav-right"
                               OnClick="() => ScrollCategoriesByAsync(1)"
                               AriaLabel="Scroll categories right" />
            </div>
        </div>
    </section>

    <section id="featured" class="featured">
        <div class="container">
            <div class="row">
                <div class="col col-12">
                    <div class="section-head">
                        <h2>Featured capsules</h2>
                        <p>Three premium statements in one quiet collection.</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col col-12 col-md-6 col-lg-4">
                    <article class="card card-premium">
                        <div class="card-visual"></div>
                        <h3>Obsidian Capsule</h3>
                        <p>Deep matte finish with precision-milled edges.</p>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-4">
                    <article class="card card-premium">
                        <div class="card-visual"></div>
                        <h3>Airline Edition</h3>
                        <p>Ultralight build with brushed aluminum touch.</p>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-4">
                    <article class="card card-premium">
                        <div class="card-visual"></div>
                        <h3>Studio Array</h3>
                        <p>Balanced acoustics engineered for quiet rooms.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <section id="products" class="products" aria-labelledby="products-title">
        <div class="container">
            <div class="row">
                <div class="col col-12">
                    <div class="section-head">
                        <h2 id="products-title">The essentials lineup</h2>
                        <p>Eight refined pieces, each built to last.</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova One</h3>
                        <p>Compact core for everyday clarity.</p>
                        <div class="product-row">
                            <span class="price">$129</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova Air</h3>
                        <p>Lightweight with a satin finish.</p>
                        <div class="product-row">
                            <span class="price">$159</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova Studio</h3>
                        <p>Balanced acoustics for focused spaces.</p>
                        <div class="product-row">
                            <span class="price">$219</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova Pro</h3>
                        <p>Extended range and refined tuning.</p>
                        <div class="product-row">
                            <span class="price">$299</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova Mini</h3>
                        <p>Minimal form, maximum focus.</p>
                        <div class="product-row">
                            <span class="price">$99</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova Max</h3>
                        <p>Immersive sound in a single slab.</p>
                        <div class="product-row">
                            <span class="price">$349</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova Duo</h3>
                        <p>Pairing-ready, always balanced.</p>
                        <div class="product-row">
                            <span class="price">$189</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
                <div class="col col-12 col-md-6 col-lg-3">
                    <article class="product">
                        <div class="product-visual"></div>
                        <h3>Nova Arc</h3>
                        <p>Curved silhouette with soft touch.</p>
                        <div class="product-row">
                            <span class="price">$239</span>
                            <button class="button button-ghost">Buy</button>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <section class="promo" aria-labelledby="promo-title">
        <div class="container">
            <div class="row">
                <div class="col col-12">
                    <div class="promo-inner">
                        <div>
                            <h2 id="promo-title">Trade in, elevate.</h2>
                            <p>Exchange your current device and receive exclusive credit.</p>
                        </div>
                        <a class="button button-primary" href="#support">Check eligibility</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
