@page "/"
@rendermode InteractiveServer
@inherits HomeBase

<MudContainer MaxWidth="MaxWidth.False" Class="store-shell">
    <MudPaper Elevation="0" Class="hero">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h3" Class="hero-title">Store.</MudText>
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="hero-sub">
                    The best way to buy the products you love.
                </MudText>

                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="hero-actions">
                    <MudTextField @bind-Value="_search"
                                  Placeholder="Search products"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="hero-search" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" >
                        Search
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudContainer>
    </MudPaper>

     <!-- CATEGORY TILES -->
    <MudContainer MaxWidth="MaxWidth.Large" Class="section">
        <MudGrid Spacing="2">
            @foreach (var c in _categories)
            {
                <MudItem xs="6" sm="4" md="3" lg="2">
                    <MudPaper Elevation="0" Class="category-tile" 
                        @onclick="() => SelectCategory(c.Name)">
                        <MudStack Spacing="0" Class="category-inner">
                            @* <MudIcon Icon="@c.Icon" /> *@
                            <MudText Typo="Typo.subtitle2">@c.Name</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>

    <MudContainer MaxWidth="MaxWidth.Large" Class="section">
        <MudPaper Class="pa-4 my-4" Elevation="1" Rounded="true">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    @_error
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2">
                        Retry
                    </MudButton>
                </MudAlert>
            }
        </MudPaper>
    </MudContainer>

    <MudContainer MaxWidth="MaxWidth.Large" Class="section">
        @RailSection(title: "All Products")
    </MudContainer>

</MudContainer>



@code{

    private RenderFragment RailSection(string title) => __builder =>
    {
        <MudPaper Elevation="0" Class="rail-section">
            <div class="rail-wrap">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Class="rail-nav rail-nav-left"
                               Disabled="@(_isLoading)"
                               OnClick="() => ScrollByAsync(-1)" />

                <div class="rail" @ref="_railRef">
                    @if (_isLoading)
                    {
                        @for (var i = 0; i < _pageSize; i++)
                        {
                            <MudCard Class="product-card">
                                <MudSkeleton Height="140px" Width="100%" />
                                <MudCardContent>
                                    <MudSkeleton Width="80%" />
                                    <MudSkeleton Width="40%" />
                                </MudCardContent>
                                <MudCardActions>
                                    <MudSkeleton Width="60%" Height="32px" />
                                </MudCardActions>
                            </MudCard>
                        }
                    }
                    else
                    {
                        @foreach (var p in _products)
                        {
                            <MudCard Class="product-card">
                                @{
                                    var img = GetPrimaryOrFirstImage(p);
                                    var editProductUrl = $"/products/{p.Id}/edit";
                                }
                                @if (img is not null)
                                {
                                    <MudImage src="@GetImageUrl(img.Url)" alt="@img.AltText" Height="140"
                                              ObjectFit="ObjectFit.Cover" />
                                }
                                else
                                {
                                    <div class="img-placeholder">
                                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
                                    </div>
                                }

                                <MudCardContent Class="pb-2">
                                    <MudText Typo="Typo.subtitle2" Class="line-clamp-2">@p.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@p.Price.ToString("C")</MudText>
                                </MudCardContent>

                                <MudCardActions Class="pt-0">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                                        View
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        }
                    }
                </div>

                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               Class="rail-nav rail-nav-right"
                               Disabled="@(_isLoading)"
                               OnClick="() => ScrollByAsync(1)" />
            </div>
        </MudPaper>
    };

}