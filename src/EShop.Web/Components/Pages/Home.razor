@page "/"
@using EShop.Web.Components.Layout
@rendermode InteractiveServer

<SiteStrip 
    PillText="Free Delivery" 
    ClaimText="New for 2026: precision-tuned accessories with trade-in credit."
    FeatureText="See Highlights">
</SiteStrip>


<MudContainer MaxWidth="MaxWidth.False" Class="store-shell">
   <MudPaper Elevation="0" Class="hero">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h3" Class="hero-title">Store.</MudText>
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="hero-sub">
                    The best way to buy the products you love.
                </MudText>

                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="hero-actions">
                    <MudTextField @bind-Value="_search"
                                  Placeholder="Search products"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="hero-search" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" >
                        Search
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudContainer>
    </MudPaper>

     <!-- CATEGORY TILES -->
    <MudContainer MaxWidth="MaxWidth.Large" Class="section">
        <section id="products-premium" class="products" aria-labelledby="products-premium-title">
            <div class="container">
                <div class="row">
                    <div class="col col-12">
                        <div class="section-head">
                            <h2 id="products-premium-title">Premium lineup</h2>
                            <p>Higher spec, same design language.</p>
                        </div>
                    </div>
                </div>

                <div class="pr-rail"
                     data-pr-rail
                     data-pr-scroll-ratio="0.85"
                     data-pr-edge-threshold="1"
                     style="--pr-item-width: 240px; --pr-item-height: 100px; --pr-media-height: 140px;"
                     aria-label="Premium lineup">
                    <button class="pr-rail__nav pr-rail__nav--left" type="button" data-pr-prev aria-label="Scroll left">
                        <span class="pr-rail__icon" aria-hidden="true">‹</span>
                    </button>

                    <div class="pr-rail__viewport" data-pr-viewport tabindex="0">
                        <div class="pr-rail__track" data-pr-track>
                            @foreach (var c in _categories)
                            {
                                <article class="product pr-rail__item" data-pr-item>
                                    <MudPaper Elevation="0" Class="category-tile" @onclick="() => SelectCategory(c.Name)">
                                        <MudStack Spacing="0" Class="category-inner">
                                             @* <MudIcon Icon="@c.Icon" />  *@
                                            <MudText Typo="Typo.subtitle2">@c.Name</MudText>
                                        </MudStack>
                                    </MudPaper>
                                </article>
                            }
                        </div>
                    </div>

                    <button class="pr-rail__nav pr-rail__nav--right" type="button" data-pr-next aria-label="Scroll right">
                        <span class="pr-rail__icon" aria-hidden="true">›</span>
                    </button>
                </div>
            </div>
        </section>
    </MudContainer>

</MudContainer>

<MudPaper Class="pa-4 my-4" Elevation="1" Rounded="true">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
            @_error
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2">
                Retry
            </MudButton>
        </MudAlert>
    }
    <section id="products-premium" class="products" aria-labelledby="products-premium-title">
        <div class="container">
            <div class="row">
                <div class="col col-12">
                    <div class="section-head">
                        <h2 id="products-premium-title">Premium lineup</h2>
                        <p>Higher spec, same design language.</p>
                    </div>
                </div>
            </div>

            <div class="pr-rail"
                 data-pr-rail
                 data-pr-scroll-ratio="0.85"
                 data-pr-edge-threshold="1"
                 style="--pr-item-width: 300px; --pr-item-height: 380px; --pr-media-height: 140px;"
                 aria-label="Premium lineup">
                <button class="pr-rail__nav pr-rail__nav--left" type="button" data-pr-prev aria-label="Scroll left">
                    <span class="pr-rail__icon" aria-hidden="true">‹</span>
                </button>

                <div class="pr-rail__viewport" data-pr-viewport tabindex="0">
                    <div class="pr-rail__track" data-pr-track>
                        @if (_isLoading)
                        {
                            <article class="product pr-rail__item" data-pr-item>
                              <div class="product-visual"></div>
                              <h3>Nova Mini</h3>
                              <p>Minimal form, maximum focus.</p>
                              <div class="product-row">
                                <span class="price">$99</span>
                                <button class="button button-ghost">Buy</button>
                              </div>
                            </article>
                                                }
                        else
                        {
                            foreach (var p in _products)
                            {
                                <MudCard Class="product-card pr-rail__item" data-pr-item>
                                    @{
                                        var img = GetPrimaryOrFirstImage(p);
                                        var editProductUrl = $"/products/{p.Id}/edit";
                                    }
                                    @if (img is not null)
                                    {
                                    <MudImage src="@GetImageUrl(img.Url)" alt="@img.AltText" Height="140"
                                              ObjectFit="ObjectFit.Cover" />
                                    }
                                    else
                                    {
                                    <div class="img-placeholder">
                                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
                                    </div>
                                    }
                                    <MudCardContent Class="pb-2">
                                        <MudText Typo="Typo.subtitle2" Class="line-clamp-2">@p.Name</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@p.Price.ToString("C")</MudText>

                                        <div class="product-row">
                                            <span class="price">@p.Price</span>
                                            <button class="button button-ghost">Buy</button>
                                        </div>
                                   </MudCardContent>
                                    <MudCardActions Class="pt-0">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                                            View
                                        </MudButton>
                                    </MudCardActions>
                                </MudCard>
                            }
                        }
                    </div>
                </div>

                <button class="pr-rail__nav pr-rail__nav--right" type="button" data-pr-next aria-label="Scroll right">
                    <span class="pr-rail__icon" aria-hidden="true">›</span>
                </button>
            </div>
        </div>
    </section>
</MudPaper>

@code {
    [Inject] protected ICatalogApiClient CatalogApiClient { get; set; } = null!;
    [Inject] protected ApiClientConfig ApiClientConfig { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private string _productDetailsBaseUrl { get; set; } = "/product";

    private const string DefaultSortBy = "Name";
    private const string DefaultSortDirection = "asc";
    private const string DefaultSearchTerm = "";
    private int _page = 1;
    private int _pageSize = 10;
    private  string _sortBy = DefaultSortBy;
    private string _sortDirection = DefaultSortDirection;
    private string _search = DefaultSearchTerm;

    private string? _error;
    private bool _isLoading;

    private List<CategoryDto> _categories = new();
    private List<ProductDto> _products = new();
    private int? _totalCount;
    private bool _canPrev => _page > 1;
    private bool _canNext
        => _totalCount is not null
            ? _page < (int)Math.Ceiling(_totalCount.Value / (double)_pageSize)
            : _products.Count == _pageSize;

    protected override async Task OnInitializedAsync()
    {
        _page = 1;
        await LoadCategoriesAsync();
        await LoadProductAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initProductRails");
        }
    }

    private async Task PrevPage()
    {
        if (!_canPrev) return;
        _page--;

        await LoadProductAsync();
    }

    private async Task NextPage()
    {
        if (!_canNext) return;
        _page++;

        await LoadProductAsync();
    }

    private async Task Reload() => await LoadProductAsync();

    private async Task LoadProductAsync(bool append = false)
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await CatalogApiClient.GetPagedProductsAsync(
                _page, _pageSize, _sortBy, _sortDirection, _search, CancellationToken.None);

            _totalCount = result.Total;

            if (append)
                _products.AddRange(result.Items);
            else
                _products = result.Items.ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (!append) _products = new();
            _totalCount = null;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            _categories = await CatalogApiClient.GetAllCategoriesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            throw;
        }
    }

    private static ProductImageDto? GetPrimaryOrFirstImage(ProductDto product)
    {
        if (product.Images is null || product.Images.Count == 0)
            return null;

        return product.Images.FirstOrDefault(i => i.IsPrimary)
            ?? product.Images.OrderBy(i => i.SortOrder).First();
    }

    private string GetImageUrl(string url) => $"{ApiClientConfig.BaseUrl}/api/images/{url}";

    private void ViewProduct(Guid productId)
    {
        Nav.NavigateTo($"{_productDetailsBaseUrl}/{productId}");
    }

    private Task SelectCategory(string value)
    {
        return Task.CompletedTask;
    }
}
