@page "/"
@rendermode InteractiveServer
@inherits HomeBase

<main id="main">
    <section class="hero" aria-labelledby="hero-title">
        <div class="container">
            <div class="row align-center">
                <div class="col col-12 col-lg-6">
                    <p class="eyebrow">Precision Series</p>
                    <h1 id="hero-title">Minimal design. Maximum presence.</h1>
                    <p class="subhead">
                        Crafted for quiet power and refined everyday rituals. A storefront that
                        feels premium without the noise.
                    </p>
                    <div class="hero-actions">
                        <a class="button button-primary" href="#featured">Shop the line</a>
                        <a class="text-link" href="#featured">Explore the collection</a>
                    </div>
                </div>
                <div class="col col-12 col-lg-6">
                    <div class="hero-visual" role="img" aria-label="Product visual placeholder">
                        <svg viewBox="0 0 520 420" aria-hidden="true">
                            <defs>
                                <linearGradient id="g1" x1="0" x2="1" y1="0" y2="1">
                                    <stop offset="0%" stop-color="#f2f4f7" />
                                    <stop offset="100%" stop-color="#dfe3ea" />
                                </linearGradient>
                            </defs>
                            <rect x="32" y="24" width="456" height="300" rx="32" fill="url(#g1)" />
                            <rect x="96" y="282" width="328" height="76" rx="22" fill="#ffffff" opacity="0.9" />
                            <circle cx="170" cy="320" r="24" fill="#cfd6df" />
                            <rect x="212" y="304" width="188" height="32" rx="16" fill="#e7ecf2" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--// end section -->

    <!-- CATEGORY TILES -->
    <section class="category-rail js-rail">
        <div class="container">
            <div class="rail-wrap">
                <MudIconButton id="category-rail-left"
                               Icon="@Icons.Material.Filled.ChevronLeft"
                               Class="rail-nav rail-nav-left js-rail-left is-hidden"
                               OnClick="() => ScrollCategoriesByAsync(-1)"
                               AriaLabel="Scroll categories left" />
                <div id="category-rail-track" class="category-rail-track js-rail-track" role="list" @ref="_categoryRailRef">
                    @foreach (var c in _categories)
                    {
                        <div class="category-rail-item" role="listitem">
                            <MudPaper Elevation="0" Class="category-tile category-tile--rail"
                                      @onclick="() => SelectCategory(c.Id)">
                                <MudStack Spacing="0" Class="category-inner">
                                    @* <MudIcon Icon="@c.Icon" /> *@
                                    <MudText Typo="Typo.subtitle2">@c.Name</MudText>
                                </MudStack>
                            </MudPaper>
                        </div>
                    }
                </div>
                <MudIconButton id="category-rail-right"
                               Icon="@Icons.Material.Filled.ChevronRight"
                               Class="rail-nav rail-nav-right js-rail-right"
                               OnClick="() => ScrollCategoriesByAsync(1)"
                               AriaLabel="Scroll categories right" />
            </div>
        </div>
    </section>

    @RailSection(title: "All Products")
    <!--// end section -->

    <section class="promo" aria-labelledby="promo-title">
        <div class="container">
            <div class="row">
                <div class="col col-12">
                    <div class="promo-inner">
                        <div>
                            <h2 id="promo-title">Trade in, elevate.</h2>
                            <p>Exchange your current device and receive exclusive credit.</p>
                        </div>
                        <a class="button button-primary" href="#support">Check eligibility</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--// end section -->
</main>


@code {
    private RenderFragment RailSection(string title) => __builder =>
    {
        <MudPaper Elevation="0" Class="featured">
            <div class="container">
                <div class="row">
                    <div class="col col-12">
                        <div class="section-head">
                            <h2>Featured capsules</h2>
                            <p>Three premium statements in one quiet collection.</p>
                        </div>
                    </div>
                </div>
                <div class="rail-wrap js-rail">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   Class="rail-nav rail-nav-left js-rail-left is-hidden"
                                   OnClick="() => ScrollRailByAsync(_featuredRailRef, -1)"
                                   AriaLabel="Scroll featured capsules left" />

                    <div class="category-rail-track js-rail-track" role="list" @ref="_featuredRailRef">
                        @if (_isLoading)
                        {
                            @for (var i = 0; i < _pageSize; i++)
                            {
                                <div class="category-rail-item" role="listitem">
                                    <article class="card card-premium">
                                        <div class="card-visual"></div>
                                        <h3>Obsidian Capsule</h3>
                                        <p>Deep matte finish with precision-milled edges.</p>
                                    </article>
                                </div>
                            }
                        } else
                        {
                            @foreach (var product in _products) {
                                var img = GetPrimaryOrFirstImage(product);
                                var editProductUrl = $"/products/{product.Id}/edit";
                                
                                <div class="category-rail-item" role="listitem">
                                    <article class="card card-premium">
                                      @if (img is not null)
                                        {
                                        <div class="card-visual">
                                          <MudImage src="@GetImageUrl(img.Url)" alt="@img.AltText" Height="140"
                                              ObjectFit="ObjectFit.Cover" />
                                        </div>
                                        } else
                                        {
                                            <div class="card-visual">
                                            </div>
                                        }
                                        <h3>@product.Name</h3>
                                        <p>@product.Description</p>
                                    </article>
                                </div>
                            }
                        }
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   Class="rail-nav rail-nav-right js-rail-right"
                                   OnClick="() => ScrollRailByAsync(_featuredRailRef, 1)"
                                   AriaLabel="Scroll featured capsules right" />
                </div>
            </div>
        </MudPaper>
    };
}