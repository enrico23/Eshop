@page "/products"
@using EShop.Shared.Domain
@using EShop.Web.Components.Pages.Categories
@using EShop.Web.Exceptions
@using EShop.Web.Components.Pages.Shared
@inherits BaseCrudPage

<MudPaper Class="pa-4">
    <GenericGrid TItem="ProductDto"
                 @ref="_grid"
                 ServerData="LoadProductAsync"
                 DefaultPageSize="10"
                 PageSizeOptions="new[] {5, 10, 25, 50 }"
                 SearchPlaceholder="Search..."
                 AddButtonText="Add Product"
                 OnAdd="OpenCreateDialogAsync"
                 OnEdit="OpenEditDialogAsync"
                 OnDelete="OpenDeleteDialogAsync">
        <Columns>
            <PropertyColumn T="ProductDto"
                TProperty="string"
                Property="x => x.Name" 
                Sortable="true" Filterable="false"
                />

            <PropertyColumn T="ProductDto"
                            TProperty="decimal"
                            Property="x => x.Price"
                            Sortable="true" 
                            Filterable="false"  />

            <PropertyColumn T="ProductDto"
                            TProperty="int"
                            Property="x => x.Stock"
                            Sortable="true" 
                            Filterable="false" />

            <PropertyColumn T="ProductDto"
                            TProperty="string"
                            Property="x => x.CategoryName"
                            Title="Category"
                            Sortable="true"
                            Filterable="false" />

            <PropertyColumn T="ProductDto"
                            TProperty="string"
                            Property="x => x.Status.ToString()"
                            Title="Status"
                            Sortable="true"
                            Filterable="false" />
        </Columns>
    </GenericGrid>
</MudPaper>

@code {
    private GenericGrid<ProductDto>? _grid;

    private async Task<GridData<ProductDto>> LoadProductAsync(GridState<ProductDto> state, string? searchText)
    {
        var sortBy = "Name";
        var sortDirection = "asc";
        var currentPage = state.Page;
        var pageSize = state.PageSize;

        var sortDefinition = state.SortDefinitions.FirstOrDefault();
        if (sortDefinition != null)
        {
            sortBy = sortDefinition.SortBy;
            sortDirection = sortDefinition.Descending ? "desc" : "asc";
        }

        var page = currentPage + 1;

        try
        {
            var pagedData = await CategoryApiClient.GetPagedProductsAsync(page, pageSize, sortBy, sortDirection, searchText, CancellationToken.None);

            return new GridData<ProductDto>
            {
                TotalItems = pagedData!.Total,
                Items = pagedData.Items
            };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.FriendlyMessage!, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unexpected error.", Severity.Error);
        }

        return new GridData<ProductDto>
        {
            TotalItems = 0,
            Items = new List<ProductDto>()
        };
    }

    private async Task OpenCreateDialogAsync()
    {
        var createProductDto = new CreateProductDto
        {
            Name = string.Empty,
            Description = string.Empty,
            Price = 0.01m,
            Stock = 1,
            CategoryId = null,
            Status = ProductStatus.Draft
        };

        var categories = await CategoryApiClient.GetAllCategoriesAsync();

        var parameters = new DialogParameters
        {
            ["Product"] = createProductDto,
            ["Categories"] = categories
        };

        var saved = await ConfirmUpsertAsync<ProductUpsertDialog, CreateProductDto>(
            title: "Create product",
            parameters: parameters,
            saveAction: model => CategoryApiClient.CreateProductAsync(model, CancellationToken.None),
            successMessage: $"Product '{createProductDto.Name}' successfully created");

        if (saved && _grid is not null)
            await _grid.ReloadAsync();
    }

    private async Task OpenEditDialogAsync(ProductDto existing)
    {
        var updateProductDto = new UpdateProductDto
        {
            Name = existing.Name,
            Description = existing.Description!,
            Price = existing.Price,
            Stock = existing.Stock,
            CategoryId = existing.CategoryId,
            Status = existing.Status,
            Sku = existing.Sku
        };

        var categories = await CategoryApiClient.GetAllCategoriesAsync();

        var parameters = new DialogParameters
            {
                ["Product"] = updateProductDto,
                ["Categories"] = categories
            };

        var saved = await ConfirmUpsertAsync<ProductUpsertDialog, UpdateProductDto>(
           title: "Edit product",
           parameters: parameters,
           saveAction: model => CategoryApiClient.UpdateProductAsync(existing.Id, model, CancellationToken.None),
           successMessage: $"Product '{updateProductDto.Name}' successfully updated");

        if (saved && _grid is not null)
            await _grid!.ReloadAsync();
    }

    private async Task OpenDeleteDialogAsync(ProductDto item)
    {
        var deleted = await ConfirmDeleteAsync<ProductDto>(
            item,
            title: "Delete Product",
            message: $"Are you sure you want to delete product '{item.Name}'?",
            deleteAction: action => CategoryApiClient.DeleteProductAsync(item.Id)
        );

        if (deleted && _grid is not null)
            await _grid.ReloadAsync();
    }
}