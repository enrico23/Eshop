@page "/products"
@using EShop.Shared.Domain
@using EShop.Web.Components.Pages.Categories
@using EShop.Web.Exceptions
@using EShop.Web.Components.Pages.Shared
@using EShop.Web.Models
@inherits CrudPageBase

<MudPaper Class="pa-4">
    <GenericGrid TItem="ProductDto"
                 @ref="_grid"
                 ServerData="LoadProductAsync"
                 DefaultPageSize="10"
                 PageSizeOptions="new[] {5, 10, 25, 50 }"
                 SearchPlaceholder="Search..."
                 ShowAddButton="true"
                 AddButtonText="Add Product"
                 OnAdd="NavigateToCreateProduct"
                 ShowActions="true"
                 OnEdit="NavigateToEditProduct"
                 OnDelete="OpenDeleteDialogAsync">
        <Columns>
            <PropertyColumn T="ProductDto"
                TProperty="string"
                Property="x => x.Name" 
                Sortable="true" Filterable="false"
                             >
                <CellTemplate Context="cellContext">
                    @{

                        var editProductUrl = $"/products/{cellContext.Item.Id}/edit";
                    }
                    <MudLink Href=@editProductUrl>
                        @cellContext.Item.Name
                    </MudLink>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn T="ProductDto"
                            TProperty="decimal"
                            Property="x => x.Price"
                            Sortable="true" 
                            Filterable="false"  />

            <PropertyColumn T="ProductDto"
                            TProperty="int"
                            Property="x => x.Stock"
                            Sortable="true" 
                            Filterable="false" />

            <PropertyColumn T="ProductDto"
                            TProperty="string"
                            Property="x => x.CategoryName"
                            Title="Category"
                            Sortable="true"
                            Filterable="false" />

            <PropertyColumn T="ProductDto"
                            TProperty="string"
                            Property="x => x.Status.ToString()"
                            Title="Status"
                            Sortable="true"
                            Filterable="false" />
            <TemplateColumn T="ProductDto">
                <HeaderTemplate>Image</HeaderTemplate>
                 <CellTemplate Context="cellContext">
                    @{
                        var img = GetPrimaryOrFirstImage(cellContext.Item);
                        var editProductUrl = $"/products/{cellContext.Item.Id}/edit";
                    }
                    <div class="img-frame img-frame--thumb">
                        <MudLink Href="@editProductUrl">
                            <div class="img-frame img-frame--thumb">
                                @if (img is not null)
                                {
                                    <img src="@GetImageUrl(img.Url)" alt="@img.AltText" class="img-cover" />
                                }
                                else
                                {
                                    <div class="img-placeholder">No image</div>
                                }
                            </div>
                        </MudLink>
                    </div>
                </CellTemplate>

            </TemplateColumn>
        </Columns>
    </GenericGrid>
</MudPaper>

@code {
    [Inject] protected ICatalogApiClient CatalogApiClient { get; set; } = null!;

    private GenericGrid<ProductDto>? _grid;

    [Inject] protected ApiClientConfig ApiClientConfig { get; set; } = null!;

    protected override Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var toast = query["error"];

        if (toast == "notfound")
            Snackbar.Add("Product not found.", Severity.Warning);
        else if (toast == "failed")
            Snackbar.Add("Failed to load product.", Severity.Error);
        else if (toast == "catagories")
            Snackbar.Add("Failed to load the categories.", Severity.Error);

        return Task.CompletedTask;
    }

    private async Task<GridData<ProductDto>> LoadProductAsync(GridState<ProductDto> state, string? searchText)
      => await LoadGridAsync(
          state,
          searchText,
          defaultSortBy: "Name",
          loadPage: (page, pageSize, sortBy, sortDir, search, ct) =>
              CatalogApiClient.GetPagedProductsAsync(page, pageSize, sortBy, sortDir, search, ct),
          cancellationToken: CancellationToken.None);

    private void NavigateToCreateProduct() => 
        NavigationManager.NavigateTo("/products/create");

    private void NavigateToEditProduct(ProductDto existing) =>
        NavigationManager.NavigateTo($"/products/{existing.Id}/edit");

    private async Task OpenDeleteDialogAsync(ProductDto item)
    {
        var deleted = await ConfirmDeleteAsync(
            title: "Delete Product",
            message: $"Are you sure you want to delete the product '{item.Name}'?",
            deleteAction: ct => CatalogApiClient.DeleteProductAsync(item.Id, ct),
            successMessage: $"Product '{item.Name}' deleted successfully.");

        if (deleted && _grid is not null)
            await _grid.ReloadAsync();
    }

    private static ProductImageDto? GetPrimaryOrFirstImage(ProductDto product)
    {
        if (product.Images is null || product.Images.Count == 0)
            return null;

        return product.Images.FirstOrDefault(i => i.IsPrimary)
            ?? product.Images.OrderBy(i => i.SortOrder).First();
    }

    private string GetImageUrl(string url) => $"{ApiClientConfig.BaseUrl}/api/images/{url}";
}
