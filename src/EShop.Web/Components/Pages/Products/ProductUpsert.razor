@page "/products/create"
@page "/products/{Id:guid}/edit"
@using EShop.Shared.Domain
@using EShop.Web.Models
@using EShop.Web.Exceptions
@using System.Net

<PageTitle>Product</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h5">@_title</MudText>
        <MudSpacer />

        <MudForm @ref="_form" Model="_model">
            <MudGrid GutterSize="2">

                <MudItem xs="10">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Name"
                                  Required="true"
                                  For="@(() => _model.Name)" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField @bind-Value="_model.Price"
                                  Label="Price"
                                  Required="true"
                                  For="@(() => _model.Price)" />
                </MudItem>

                <MudItem xs="4">
                    <MudTextField @bind-Value="_model.Stock"
                                  Label="Stock"
                                  Required="true"
                                  For="@(() => _model.Stock)" />
                </MudItem>

                <MudItem xs="6">
                    @if (_categories is null || _categories.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning">
                            No categories are available. Please create a category first.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSelect Label="Category"
                                   Placeholder="Select..."
                                   T="Guid ?" Required="true"
                                   @bind-Value="_model.CategoryId"
                                   For="@(() => _model.CategoryId)"
                                   FullWidth="true"
                                   Margin="Margin.Dense">

                            @foreach (var category in _categories)
                            {
                                <MudSelectItem T="Guid ?" Value="category.Id">@category.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <MudItem xs="4">

                    <MudSelect T="ProductStatus" Label="Status" @bind-Value="_model.Status">
                        @foreach (var status in Enum.GetValues<ProductStatus>())
                        {
                            <MudSelectItem T="ProductStatus" Value="@status">
                                @status
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="10">
                    <MudTextField @bind-Value="_model.Sku"
                                  Label="Sku"
                                  Required="true"
                                  For="@(() => _model.Sku)" />
                </MudItem>

                <MudItem xs="10">
                    <MudTextField T="string"
                                  @bind-Value="_model.Description"
                                  Label="Description"
                                  For="@(() => _model.Description)"
                                  Lines="4"
                                  MaxLength="255"
                                  Required="true"
                                  TextLengthExceededMessage="Description cannot exceed 255 characters." />
                </MudItem>

            </MudGrid>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }

            <MudStack Row Class="mt-4">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="SubmitAsync"
                           Disabled="_isSaving || _categories.Count == 0">
                    @(_isCreate ? "Create" : "Save")
                </MudButton>

                @if (_isSaving)
                {
                    <MudProgressCircular Class="ml-2"
                                         Color="Color.Primary"
                                         Size="Size.Medium"
                                         Indeterminate="true" />
                }
            </MudStack>
        </MudForm>

    </MudPaper>
}

@code {

    [Parameter] public Guid? Id { get; set; }

    [Inject] protected ICatalogApiClient CatalogApiClient { get; set; } = null!;
    [Inject] protected NavigationManager NavigationManager { get; set; } = null!;
    [Inject] protected ISnackbar Snackbar { get; set; } = null!;

    private bool _isCreate => !Id.HasValue;
    private bool _isLoading = true;
    private bool _isSaving;
    private string _error = "";
    private string _title = "";

    private ProductDto? _product = null!;
    private CreateProductViewModel _model = null!;
    private List<CategoryDto> _categories = new();
    private MudForm _form = null!;


    protected override async Task OnInitializedAsync()
    {
        _categories = await CatalogApiClient.GetAllCategoriesAsync();

        _model = new CreateProductViewModel
        {
            Name = "",
            Description = "",
            Sku = "",
            Price = 0.01m,
            Stock = 1,
            Status = EShop.Shared.Domain.ProductStatus.Draft
        };

        if (_isCreate)
        {
            _title = "Create Product";
        }
        else
        {
            _product = await CatalogApiClient.GetByIdAsync(Id!.Value);
            if (_product is not null)
            {
                _title = $"Edit Product {_product.Name}";

                _model = new CreateProductViewModel()
                {
                    Name = _product.Name,
                    Description = _product.Description ?? string.Empty,
                    Sku = _product.Sku,
                    Price = _product.Price,
                    Stock = _product.Stock,
                    Status = _product.Status,
                    CategoryId = _product.CategoryId,
                    Images = _product.Images
                };
            }
        }

        _isLoading = false;
    }

    private async Task SubmitAsync()
    {
        _error = "";
        _isSaving = true;

        await _form.Validate();
        if (!_form.IsValid)
        {
            _isSaving = false;
            return;
        }

        try
        {
            if (_isCreate)
            {
                await CatalogApiClient.CreateProductAsync(_model, _model.File, CancellationToken.None);
                Snackbar.Add($"Product '{_model.Name}' created successfully.", Severity.Success);
            }
            else
            {
                await CatalogApiClient.UpdateProductAsync(Id!.Value, _model, _model.File, CancellationToken.None);
                Snackbar.Add($"Product '{_model.Name}' updated successfully.", Severity.Success);
            }

            NavigationManager.NavigateTo("/products");
        }
        catch (ApiException ex) when (ex.StatusCode is HttpStatusCode.Conflict)
        {
            Snackbar.Add(ex.Message!, Severity.Error);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.FriendlyMessage!, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unexpected error.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
