@page "/products/create"
@page "/products/{Id:guid}/edit"
@using EShop.Shared.Domain
@using EShop.Web.Models
@using EShop.Web.Exceptions
@using System.Net
@using System.Linq
@inherits ProductUpsertBase

<PageTitle>@PageTitle</PageTitle>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
<MudForm @ref="UpsertForm" Model="UpsertModel">
    <MudPaper Class="pa-4">
        
        <MudGrid AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h4">@PageTitle
                        <MudChip T="ProductDto" Variant="Variant.Filled" Size="Size.Small">
                            @UpsertModel.Status
                        </MudChip>
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Row="true" JustifyContent="flex-end" AlignItems="AlignItems.Center" Spacing="2" Class="header-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsSaving" OnClick="SubmitAsync">
                        Save
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled=IsSaving" 
                                   OnClick="@(()=> NavigationManager.NavigateTo("/products"))">
                        Cancel
                    </MudButton>

                        @if (IsSaving)

                        {

                            <MudProgressCircular Class="ml-2"
                                                 Color="Color.Primary"
                                                 Size="Size.Medium"
                                                 Indeterminate="true" />
                        }
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudDivider Invisible="true" Class="my-4" />

        <!-- Main layout: Left (tabs + form) / Right (sidebar cards) -->

        

            <MudGrid Spacing="3">

                <!-- LEFT -->
                <MudItem xs="12" md="8">
                    <MudPaper Elevation="1" Class="pa-4">
                       
                        <MudTabs Rounded="true" Border="true" ApplyEffectsToContainer="true">

                            <MudTabPanel Text="Metadata" Icon="@Icons.Material.Filled.Info">
                                
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="UpsertModel.Name" Label="Name" Required="true" For="@(() => UpsertModel.Name)" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="UpsertModel.Price" Label="Price" Required="true" For="@(() => UpsertModel.Price)" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="UpsertModel.Stock" Label="Stock" Required="true" For="@(() => UpsertModel.Stock)" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="UpsertModel.Sku" Label="Sku" Required="true" For="@(() => UpsertModel.Sku)" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField T="string"
                                                    @bind-Value="UpsertModel.Description"
                                                    Label="Description"
                                                    For="@(() => UpsertModel.Description)"
                                                    Lines="4"
                                                    MaxLength="255"
                                                    Required="true"
                                                    TextLengthExceededMessage="Description cannot exceed 255 characters." />
                                </MudItem>
                                
                                <!-- Primary image header row -->
                                <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="space-between" Class="mt-2">
                                    <MudText Typo="Typo.h6">Primary image</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"> ( PNG JPG WEBP 5 MB )</MudText>
                                    <MudTooltip Text="Upload primary image">
                                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadPrimaryImage"
                                                        MaxFileSize="5_000_000"
                                                        MaxItems="1"
                                                        Accept=".png,.jpg,.jpeg,.webp">
                                            <ActivatorContent>
                                                <MudButton Variant="Variant.Filled"
                                                            Color="Color.Primary"
                                                            StartIcon="@Icons.Material.Filled.CloudUpload">
                                                    Upload Files
                                                </MudButton>
                                            </ActivatorContent>
                                        </MudFileUpload>
                                    </MudTooltip>
                                    
                                </MudStack>

                                <MudGrid Spacing="2" Class="mt-2">

                                    <!-- Left: existing images -->
                                    <MudItem xs="12" md="7">
                                        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                            <MudText Typo="Typo.subtitle1" Class="mb-2">Primary Image</MudText>

                                            @if (UpsertModel.Images is { Count: > 0 })
                                            {
                                                <MudGrid Spacing="2">
                                                    @foreach (var image in UpsertModel.Images.OrderBy(i => i.SortOrder))
                                                    {
                                                        <MudItem xs="6" sm="4" lg="3">
                                                            <MudPaper Class="pa-2" Outlined="true">
                                                                <div class="img-frame">
                                                                    <img src="@GetImage(image.Url)"
                                                                         alt="@image.AltText"
                                                                         class="img-cover" />
                                                                </div>

                                                                @* Optional: caption/actions *@
                                                                @* <MudText Typo="Typo.caption" Class="mt-1">@image.AltText</MudText> *@
                                                            </MudPaper>
                                                        </MudItem>
                                                    }
                                                </MudGrid>
                                            }
                                            else
                                            {
                                                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                                    No images uploaded yet.
                                                </MudAlert>
                                            }
                                        </MudPaper>
                                    </MudItem>

                                    <!-- Right: upload + preview -->
                                    <MudItem xs="12" md="5">
                                        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                            <MudStack Spacing="2">

                                                <MudStack Row="true" AlignItems="AlignItems.Center" JustifyContent="space-between">
                                                    <MudText Typo="Typo.subtitle1">Upload Preview</MudText>

                                                    @* Your upload control/button goes here *@
                                                    @* <MudButton ...>Upload files</MudButton> *@
                                                </MudStack>

                                                @if (PreviewPrimaryImage is not null)
                                                {
                                                    <MudPaper Outlined="true" Class="pa-2">
                                                        <div class="img-frame img-frame--wide">
                                                            <img src="@_previewPrimaryImageUrl" alt="Preview" class="img-cover" />
                                                        </div>

                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                                                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                                                            <MudText Typo="Typo.subtitle2">@PreviewPrimaryImage.Name</MudText>
                                                            <MudSpacer />
                                                            <MudText Typo="Typo.caption"><code>@PreviewPrimaryImage.Size</code> bytes</MudText>
                                                        </MudStack>
                                                    </MudPaper>
                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                                        Upload an image to preview it here.
                                                    </MudAlert>
                                                }

                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>

                                </MudGrid>

                            </MudTabPanel>

                            @* @if (!IsCreate)
                            {
                                <MudTabPanel Text="Images" Icon="@Icons.Material.Filled.Image">
                                    <MudPaper Class="pa-3">
                                        <MudText Typo="Typo.subtitle1">Images</MudText>
                                        <MudDivider Class="my-2" />

                                        @if (_model.Images is { Count: > 0 })
                                        {
                                            <MudGrid GutterSize="2">
                                                @foreach (var image in _model.Images.OrderBy(i => i.SortOrder))
                                                {
                                                    <MudItem xs="12" sm="6" md="4" lg="3">
                                                        <MudPaper Class="pa-1">
                                                            <MudImage Src="@GetImage(image.Url)" Alt="@image.AltText"
                                                            Width="200" Height="150"
                                                            Elevation="25" Class="rounded-lg ma-4" />

                                                        </MudPaper>
                                                    </MudItem>
                                                }
                                            </MudGrid>
                                        }
                                        else
                                        {
                                            <MudAlert Severity="Severity.Info">No images uploaded yet.</MudAlert>
                                        }
                                    </MudPaper>
                                </MudTabPanel>
                            } *@
                        </MudTabs>

                        
                    </MudPaper>
               </MudItem>

               <!-- RIGHT SIDEBAR -->
               <MudItem xs="12" md="4">
                   <MudStack Spacing="3">
                        <MudPaper Elevation="1" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-2">Publishing</MudText>

                            <MudItem xs="12">
                                <MudSelect T="ProductStatus" Label="Status" @bind-Value="UpsertModel.Status">
                                    @foreach (var status in Enum.GetValues<ProductStatus>())
                                    {
                                        <MudSelectItem T="ProductStatus" Value="@status">
                                            @status
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudPaper>

                        <MudPaper ECvation="1" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-2">Classification</MudText>

                            <MudItem xs="12">
                                @if (Categories is null || Categories.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Warning">
                                        No categories are available. Please create a category first.
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudSelect Label="Category"
                                                Placeholder="Select..."
                                                T="Guid ?" Required="true"
                                                @bind-Value="UpsertModel.CategoryId"
                                                For="@(() => UpsertModel.CategoryId)"
                                                FullWidth="true"
                                                Margin="Margin.Dense">

                                        @foreach (var category in Categories)
                                        {
                                            <MudSelectItem T="Guid ?" Value="category.Id">@category.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudItem>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-2">Audit</MudText>

                            <MudStack Spacing="2">
                                <div>
                                    <MudText Typo="Typo.subtitle2">Created</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary"> Some date</MudText>
                                </div>

                                <div>
                                    <MudText Typo="Typo.subtitle2">Updated</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Some Date</MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudStack>
                </MudItem>

            </MudGrid>

        </MudPaper>

    </MudForm>
}

<style>
    /* Consistent thumbnail sizing (no stretching, no weird max-width battles) */
    .img-frame {
        width: 100%;
        aspect-ratio: 1 / 1; /* square thumbs */
        overflow: hidden;
        border-radius: 8px;
    }

    .img-frame--wide {
        aspect-ratio: 16 / 9; /* preview area */
    }

    .img-cover {
        width: 100%;
        height: 100%;
        object-fit: cover; /* key: consistent crops */
        display: block;
    }
</style>