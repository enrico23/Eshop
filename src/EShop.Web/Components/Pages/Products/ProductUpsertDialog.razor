@using EShop.Web.Clients
@using EShop.Web.Exceptions
@using MudBlazor

<MudDialog>
    <DialogContent>

        <MudForm @ref="form">
            <ProductForm Product="Product" Categories="Categories" />
        </MudForm>

        @if (!string.IsNullOrEmpty(ServerError))
        {
            <MudSpacer />
            <MudText Color="Color.Error">@ServerError</MudText>
        }

        @if (IsSubmitting)
        {
            <MudSpacer />
            <MudProgressCircular 
                Color="Color.Primary"
                Size="Size.Medium"
                Indeterminate="true" />
        }

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="SubmitForm"
                   Disabled="@IsSubmitting">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ProductUpsertDto Product { get; set; } = null!;

    [Parameter] public List<CategoryDto> Categories { get; set; } = new();

    private MudForm form = null!;
    private bool IsSubmitting = false;
    private string ServerError = "";

    private async Task SubmitForm()
    {
        ServerError = "";
        IsSubmitting = true;

        await form.Validate();
        if (!form.IsValid)
        {
            IsSubmitting = false;
            return;
        }

        MudDialog.Close(DialogResult.Ok(Product));
        IsSubmitting = false;
    }

    private void Cancel() => MudDialog.Cancel();
}
