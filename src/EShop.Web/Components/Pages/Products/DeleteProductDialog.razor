@using System.Threading.Tasks
@using EShop.Web.Exceptions

<MudDialog>
    <DialogContent>
        <MudText>Are you sure that you want to delete the product '@productName'?</MudText>

        @if (!string.IsNullOrEmpty(ServerError))
        {
            <MudSpacer />
            <MudText Color="Color.Error" Class="mt-2">@ServerError</MudText>
        }

        @if (IsSubmitting)
        {
            <MudSpacer />
            <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true" />
        }

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Submit" Disabled="@IsSubmitting">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ProductDto? ProductParam { get; set; }

    private string ServerError = string.Empty;
    private bool IsSubmitting = false;
    private int productId;
    private string productName = string.Empty;

    [Inject] ICatalogApiClient CategoryApiClient { get; set; } = null!;

    protected override void OnInitialized()
    {
        if (ProductParam != null)
        {
            productId = ProductParam.Id;
            productName = ProductParam.Name;
        }
    }

    private async Task Submit() 
    {
        IsSubmitting = true;

        try
        {
            await CategoryApiClient.DeleteProductAsync(productId, CancellationToken.None);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            ServerError = ex.FriendlyMessage!;
        }
        catch (Exception)
        {
            ServerError = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}