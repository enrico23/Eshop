@using EShop.Shared.Domain
@using EShop.Shared.Representations.Category
@using EShop.Shared.Representations.Product
@using EShop.Web.Models
@using MudBlazor
@inherits ComponentBase

<MudGrid GutterSize="2">

    <MudItem xs="12">
        <MudTextField @bind-Value="Product.Name"
                      Label="Name"
                      Required="true"
                      For="@(() => Product.Name)" />
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="Product.Price"
                      Label="Price"
                      Required="true"
                      For="@(() => Product.Price)" />
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="Product.Stock"
                      Label="Stock"
                      Required="true"
                      For="@(() => Product.Stock)" />
    </MudItem>

    <MudItem xs="12">
        @if (Categories is null || Categories.Count == 0)
        {
            <MudAlert Severity="Severity.Warning">
                No categories are available. Please create a category first.
            </MudAlert>
        }
        else
        {
            <MudSelect Label="Category"
                       Placeholder="Select..."
                       T="Guid?" Required="true"
                       @bind-Value="Product.CategoryId"
                       For="@(() => Product.CategoryId)"
                       FullWidth="true"
                       Margin="Margin.Dense">

                @foreach (var category in Categories)
                {
                    <MudSelectItem T="Guid?" Value="category.Id">@category.Name</MudSelectItem>
                }
            </MudSelect>
        }
    </MudItem>

   
    <MudItem xs="12">

        <MudSelect T="ProductStatus" Label="Status" @bind-Value="Product.Status">
            @foreach (var status in Enum.GetValues<ProductStatus>())
            {
                <MudSelectItem T="ProductStatus" Value="@status">
                    @status
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="Product.Sku"
                      Label="Sku"
                      Required="true"
                      For="@(() => Product.Sku)" />
    </MudItem>

    <MudItem xs="12">
        <MudTextField T="string"
                      @bind-Value="Product.Description"
                      Label="Description"
                      For="@(() => Product.Description)"
                      Lines="4"
                      MaxLength="255"
                      Required="true"
                      TextLengthExceededMessage="Description cannot exceed 255 characters." />
    </MudItem>

</MudGrid>

<MudText Typo="Typo.h5">Upload product image</MudText>

<MudDivider Class="my-2" />

<MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" 
                MaxFileSize="5_000_000"
               MaxItems="1"
               Accept=".png,.jpg,.jpeg,.webp">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload">
            Upload Files
        </MudButton>
    </ActivatorContent>
</MudFileUpload>


<MudText Class="mt-2" Color="Color.Default" Typo="Typo.body2">
    Allowed: .png, .jpg, .jpeg, .webp – Max 5 MB
</MudText>

<hr />

@if (Product.Images is not null && Product.Images.Any())
{
    <p>Product Images: @Product.Images?.Count()</p>
    <MudText Class="mt-2" Color="Color.Default" Typo="Typo.body2">
        @Product.Images!.First().Url
    </MudText>
}


    @if (_files != null)
{
    <MudText Typo="@Typo.h6">@_files.Count() File@(_files.Count() == 1 ? "" : "s"):</MudText>
    <MudList T="string">
        @foreach (var file in _files)
        {
            <MudListItem Icon="@Icons.Material.Filled.AttachFile" @key="@file">
                @file.Name <code>@file.Size bytes</code>
            </MudListItem>
        }
    </MudList>
} 




@if (!string.IsNullOrEmpty(_previewImageUrl))
{
    <MudDivider Class="my-4" />

    <MudText Typo="Typo.subtitle1">Preview</MudText>

    <div class="mt-2 d-flex">
        <img src="@_previewImageUrl"
             alt="Preview"
             style="max-width: 300px; max-height: 300px; border-radius: 8px;" />
    </div>
}

@code {
    [Parameter]
    public CreateProductViewModel Product { get; set; } = null!;

    [Parameter]
    public List<CategoryDto> Categories { get; set; } = new();

    IList<IBrowserFile> _files = new List<IBrowserFile>();

    private string? _previewImageUrl;


    protected override void OnParametersSet()
    {
        // if (_previewImageUrl is null && Product.Images is { Count: > 0 })
        // {
        //     var primary = Product.Images.FirstOrDefault(i => i.IsPrimary) ?? Product.Images.First();
        //     _previewImageUrl = primary.Url;   this comes from the DB
        // }
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        // var file = _files.FirstOrDefault();
        // if (file is null)
        // {
        //     _previewImageUrl = null;
        //     return;
        // }

        Product.File = file;

        _files.Add(file);

        try
        {
            // Read bytes (you can stream to storage instead)
            using var stream = file.OpenReadStream(5_000_000); // 5 MB max
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            var base64 = Convert.ToBase64String(bytes);
            var contentType = file.ContentType ?? "image/png";

            _previewImageUrl = $"data:{contentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            // Logger.LogError(ex, "Failed to read uploaded image");
            _previewImageUrl = null;
        }
    }
}
