/* */

.store-shell {
    padding: 0;
}

.hero {
    padding: 48px 0 28px 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.00));
}

.hero-title {
    font-weight: 700;
    letter-spacing: -0.02em;
}

.hero-sub {
    max-width: 720px;
}

.hero-actions {
    margin-top: 16px;
}

.hero-search {
    width: min(560px, 100%);
}

.section {
    padding-top: 18px;
    padding-bottom: 18px;
}

.category-tile {
    border-radius: 16px;
    padding: 14px 14px;
    background: rgba(255,255,255,0.05);
    cursor: pointer;
    transition: transform 140ms ease, background 140ms ease;
}

    .category-tile:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,0.08);
    }

.category-inner {
    min-height: 54px;
    justify-content: center;
}


.rail-section {
    border-radius: 18px;
    padding: 14px 10px 8px 10px;
    background: rgba(255,255,255,0.03);
}

.rail-header {
    padding: 6px 12px 0 12px;
}

.rail-title {
    font-weight: 650;
    letter-spacing: -0.01em;
}


.rail-wrap {
    position: relative;
    margin-top: 6px;
}

.rail {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 16px 44px;
    scroll-snap-type: x mandatory;
}

.apple-card {
    box-shadow: none;
    background: rgba(255,255,255,0.04);
    transition: transform 140ms ease, background 140ms ease;
}

.apple-card:hover {
    transform: translateY(-2px);
    background: rgba(255,255,255,0.07);
}

.card-media {
    overflow: hidden;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
}

.img-placeholder {
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.04);
}

/* MudBlazor components => deep */

::deep .product-card {
    flex: 0 0 auto;
    width: 220px;
    margin: 0 8px;
    border-radius: 12px;
}

::deep .rail-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(0,0,0,0.22);
    backdrop-filter: blur(8px);
}

::deep .rail-nav-left {
    left: 6px;
}

::deep .rail-nav-right {
    right: 6px;
}

::deep .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
}
