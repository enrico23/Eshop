@page "/categories"
@rendermode InteractiveServer
@using EShop.Shared.Representations
@using EShop.Shared.Representations.Category
@using Eshop.Web.Clients
@inject CategoryApiClient CategoryApiClient

<h3>Index</h3>

@if (isLoading)
{
    <p>Loading categories...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <td @onclick="@(() => SortBy("Id"))" style="cursor:pointer">Name @SortIcon("Id")</td>
                <td @onclick="@(() => SortBy("Name"))" style="cursor:pointer">Name @SortIcon("Name")</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in categories!.Items)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            <li class="page-item @(categories.Page == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="PreviousPage">Previous</button>
            </li>

            @foreach (var p in VisiblePageNumbers())
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                </li>
            }

            <li class="page-item @(categories.Page* categories.PageSize >= categories.Total ? "disabled" : "")">
                <button class="page-link" @onclick="NextPage">Next</button>
            </li>
        </ul>
    </nav>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;

    private PaginatedResult<CategoryDto>? categories;
    private int page = 1;
    private int pageSize = 10;
    private string orderBy = "Name";
    private string orderDirection = "asc";


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            categories = await CategoryApiClient.GetPagedCategoriesAsync(page, pageSize, orderBy, orderDirection)
                ?? new(Array.Empty<CategoryDto>(), 1, 10, 0);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading categories: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ---------- Sorting ----------
    private async Task SortBy(string column)
    {
        if (orderBy == column)
            orderDirection = orderDirection == "asc" ? "desc" : "asc";
        else
        {
            orderBy = column;
            orderDirection = "asc";
        }

        page = 1;
        await LoadDataAsync();
    }

    private MarkupString SortIcon(string column)
    {
        if (orderBy != column) return new MarkupString("");

        return orderDirection == "asc"
            ? new MarkupString("▲")
            : new MarkupString("▼");
    }

    // ---------- Paging ----------

    private async Task PreviousPage()
    {
        if (page > 1)
        {
            page--;
            await LoadDataAsync();
        }
    }

    private async Task NextPage()
    {
        if (pageSize <= 0) return;

        var maxPage = (int)Math.Ceiling((double)categories!.Total / pageSize);

        if (page < maxPage)
        {
            page++;
            await LoadDataAsync();
        }
    }

    private IEnumerable<int> VisiblePageNumbers()
    {
        if (pageSize <= 0) yield break;

        const int maxButtons = 5;
        var totalPages = (int)Math.Ceiling((double)(categories?.Total ?? 0) / pageSize);

        if (totalPages <= 0)
        {
            yield break;
        }

        int start = Math.Max(1, page - 2);
        int end = Math.Min(totalPages, start + maxButtons - 1);

        if (end - start < maxButtons - 1)
            start = Math.Max(1, end - (maxButtons - 1));

        for (int i = start; i <= end; i++)
            yield return i;
    }

    private async Task GoToPage(int p)
    {
        if (p < 1) return;
        if (pageSize <= 0) return;

        int maxPage = (int)Math.Ceiling((double)categories!.Total / pageSize);
        if (p > maxPage) return;

        page = p;
        await LoadDataAsync();
    }
}