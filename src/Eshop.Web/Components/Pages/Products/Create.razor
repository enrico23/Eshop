@page "/products/create"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@using EShop.Shared.Representations.Brand
@using EShop.Shared.Representations.Category
@using EShop.Shared.Representations.Product
@using EShop.Shared.Representations
@using System.Net
@inject NavigationManager NavigationManager

<div class="container">
    @if (isLoading)
    {
        <div class="row">Loading...</div>
    }
    else
    {
        <div class="row">
            <h3>Create New Product</h3>
        </div>
    
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="CreateProductDto" OnValidSubmit="AddProduct" FormName="create">
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />

                    <div class="mb-3">
                        <label for="Name" class="form-label">Name:</label>
                        <InputText id="Name" @bind-Value="CreateProductDto.Name" class="form-control" />
                        <ValidationMessage For="() => CreateProductDto.Name" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="Price" class="form-label">Price:</label>
                    <InputNumber id="Price" @bind-Value="CreateProductDto.Price" class="form-control" />
                    <ValidationMessage For="() => CreateProductDto.Price" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="Stock" class="form-label">Stock:</label>
                        <InputNumber id="Stock" @bind-Value="CreateProductDto.Stock" class="form-control" />
                        <ValidationMessage For="() => CreateProductDto.Stock" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="Description" class="form-label">Description:</label>
                        <InputText id="Description" @bind-Value="CreateProductDto.Description" class="form-control" />
                        <ValidationMessage For="() => CreateProductDto.Description" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <InputSelect class="form-select" @bind-Value="CreateProductDto.CategoryId">
                            <option value="">-- Select category --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => CreateProductDto.CategoryId" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Brand</label>
                        <InputSelect class="form-select" @bind-Value="CreateProductDto.BrandId">
                            <option value="">-- Select brand --</option>
                            @foreach (var b in brands)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => CreateProductDto.BrandId" class="text-danger" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-2">Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private CreateProductDto CreateProductDto { get; set; } = new();

    private HttpClient? client;

    private List<CategoryDto> categories = new();
    private List<BrandDto> brands = new();

    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? serverError;

    protected override async Task OnInitializedAsync()
    {
        client = HttpFactory.CreateClient("CatalogApi");
        var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        try
        {

            var categoriesTask = client.GetFromJsonAsync<List<CategoryDto>>("api/categories/all", jsonOptions);
            var brandsTask = client.GetFromJsonAsync<List<BrandDto>>("api/brands/all", jsonOptions);
            await Task.WhenAll(categoriesTask, brandsTask);
            categories = await categoriesTask ?? new List<CategoryDto>();
            brands = await brandsTask ?? new List<BrandDto>();
        }
        catch (Exception ex)
        {
            serverError = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task AddProduct()
    {
        if (client is null)
        {
            serverError = "HttpClient is not available.";
            return;
        }

        isSubmitting = true;
        serverError = null;

        var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        try
        {
            var response = await client.PostAsJsonAsync("api/products", CreateProductDto, jsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/products");
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                try
                {
                    var errors = await response.Content.ReadFromJsonAsync<Dictionary<string, string[]>>(jsonOptions);
                    if (errors != null && errors.Count > 0)
                    {
                        // Flatten to a readable string
                        serverError = string.Join(" ", errors.SelectMany(kv => kv.Value.Select(v => $"{kv.Key}: {v}")));
                    }
                    else
                    {
                        // if the payload isn't the expected shape, try to read plain text
                        var text = await response.Content.ReadAsStringAsync();
                        serverError = string.IsNullOrWhiteSpace(text) ? $"Validation failed ({(int)response.StatusCode})" : text;
                    }
                }
                catch
                {
                    var text = await response.Content.ReadAsStringAsync();
                    serverError = string.IsNullOrWhiteSpace(text) ? $"Validation failed ({(int)response.StatusCode})" : text;
                }

                return;
            }

            // other non-success statuses
            var body = await response.Content.ReadAsStringAsync();
            serverError = $"Server returned {(int)response.StatusCode} {response.ReasonPhrase}. {(!string.IsNullOrWhiteSpace(body) ? body : "")}";
        }
        catch (Exception ex)
        {
            serverError = $"Failed to save product: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
