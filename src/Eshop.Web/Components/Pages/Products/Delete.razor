@page "/products/delete"
@rendermode InteractiveServer
@using Eshop.Web.Components.Shared
@inject NavigationManager Navigation

<h3>Delete @Id</h3>

<p>@Summary</p>

<button class="btn btn-danger" @onclick="() => isDialogShown = true">Delete</button>

<ModalDialog IsVisible="@isDialogShown"
             IsVisibleChanged="@((val) => isDialogShown = val)"
             Title="Delete Item"
             ConfirmText="Delete"
             ShowCancel="true"
             CancelText="Cancel"
             ShowConfirm="true"
             OnConfirm="DeleteItem">
    <p>Are you sure you want to delete this item?</p>
</ModalDialog>

@code {
    [SupplyParameterFromQuery]
    public int? Id { get; set; }

    public bool isDialogShown { get; set; }

    private void DeleteItem()
    {
        Navigation.NavigateTo("/products");
    }
}