@page "/products/delete"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@using EShop.Shared.Representations.Product
@using EShop.Shared.Representations
@inject NavigationManager NavigationManager
@using Eshop.Web.Components.Shared

<div class="container">
    @if (product is null && !loadFailed)
    {
        <div class="row">Loading...</div>
    }
    else if (loadFailed)
    {
        <div class="row">
            <div class="alert alert-danger">Failed to load product. 
                <a href="/products">Back to list</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <h3>Details @product!.Name</h3>
        </div>
        <dl class="row">
            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@product.Price.ToString("C2")</dd>
            <dt class="col-sm-2">Stock</dt>
            <dd class="col-sm-10">@product.Stock</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@product.Description</dd>
            <dt class="col-sm-2">Category:</dt>
            <dd class="col-sm-10">@product.CategoryName</dd>
            <dt class="col-sm-2">Brand:</dt>
            <dd class="col-sm-10">@product.BrandName</dd>
        </dl>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <button class="btn btn-danger" @onclick="() => isDialogShown = true">Delete</button>
        <a class="btn btn-secondary ms-2" href="/products">Back to List</a>

        <ModalDialog IsVisible="@isDialogShown"
                     IsVisibleChanged="@((val) => isDialogShown = val)"
                     Title="Delete Item"
                     ConfirmText="Delete"
                     ShowCancel="true"
                     CancelText="Cancel"
                     ShowConfirm="true"
                     OnConfirm="DeleteProduct">

            <p>
                Are you sure you want to delete this product?
                <br /> <b>@product.Name</b>
            </p>

            @if (isDeleting)
            {
                <div class="mt-2">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-2">Deleting...</span>
                </div>
            }
        </ModalDialog>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int? Id { get; set; }

    private HttpClient? client;
    private ProductDto? product = null;
    public bool isDialogShown { get; set; }

    private bool isDeleting = false;
    private string? errorMessage;
    private bool loadFailed = false;

    protected override async Task OnParametersSetAsync()
    {
        client = HttpFactory.CreateClient("CatalogApi");

        try
        {
            product = await client.GetFromJsonAsync<ProductDto>($"api/products/{Id}");
            if (product is null)
            {
                NavigationManager.NavigateTo("/products");
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine($"Product not found: {Id}");
            NavigationManager.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load product {Id}: {ex.Message}");
            loadFailed = true;
        }
    }

    private async Task DeleteProduct()
    {
        if (client is null || Id is null || product is null)
            return;

        isDeleting = true;
        errorMessage = null;
        StateHasChanged();

        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));

        try
        {
            var response = await client.DeleteAsync($"api/products/{Id}", cts.Token);
            if (response.IsSuccessStatusCode)
            {
                isDialogShown = false;
                NavigationManager.NavigateTo($"/products?deleted=true&name={Uri.EscapeDataString(product!.Name)}");
                return;
            }

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                NavigationManager.NavigateTo("/products");
                return;
            }

            var serverError = await response.Content.ReadAsStringAsync(cts.Token);
            errorMessage = $"Delete failed: {serverError}";
        }
        catch (TaskCanceledException)
        {
            // timeout or explicit cancellation
            errorMessage = "Request timed out. Please try again.";
        }
        catch (HttpRequestException ex)
        {
            // connection refused, DNS error, server not reachable, etc.
            errorMessage = $"Network error: {ex.Message}";
        }
        catch (Exception ex)
        {
            // unexpected
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }
}
