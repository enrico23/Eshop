@page "/products"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@using EShop.Shared.Representations.Product
@using EShop.Shared.Representations
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ILoggerFactory LoggerFactory

<div class="container">
    <h3>Products</h3>

    <div class="row">
        <a href="/Products/create" class="mt-3 mb-3">Create New Product</a>
    </div>

    <QuickGrid ItemsProvider="productsProvider" Pagination="pagination" Class="table table-bordered">
        <PropertyColumn Property="@(p => p.Id)" Sortable="true" />
        <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
        <PropertyColumn Property="@(p => p.Price)" Format="C2" Sortable="true"></PropertyColumn>
        <PropertyColumn Property="@(p => p.Stock)" />

        <TemplateColumn Context="product">
            <a href="@($"Products/edit?id={product.Id}")">Edit</a> |
            <a href="@($"Products/details?id={product.Id}")">Details</a> |
            <a href="@($"Products/delete?id={product.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>

    <Paginator State="pagination" />
</div>
    
@code {
    private const int DefaultPageSize = 10;
    PaginationState pagination = new PaginationState { ItemsPerPage = DefaultPageSize };
    GridItemsProvider<ProductDto>? productsProvider;
    private HttpClient? client;

    private record SortItem(string orderBy, string orderDirection);

    protected override async Task OnInitializedAsync()
    {
        client = HttpFactory.CreateClient("CatalogApi");
        var logger = LoggerFactory.CreateLogger("ProductsLogger");

        productsProvider = async req =>
        {
            var count = req.Count <= 0 ? DefaultPageSize : req.Count;
            var pageNumber = (req.StartIndex / count) + 1;

            var sortItems = req.GetSortByProperties()
                              .Select(sp => new SortItem(sp.PropertyName, sp.Direction == SortDirection.Ascending ? "asc" : "desc"))
                              .ToList();
            var sortItem = sortItems.FirstOrDefault() ?? new SortItem(orderBy: "Name", orderDirection: "asc");

            try
            {
                var ct = req.CancellationToken;
                var url = $"api/products?page={pageNumber}&pageSize={count}&orderBy={sortItem.orderBy}&orderDirection={sortItem.orderDirection}";
                var result = await client.GetFromJsonAsync<PaginatedResult<ProductDto>>(url, ct);
                var items = result?.Items?.ToList() ?? new List<ProductDto>();
                var total = result?.Total ?? 0;

                return GridItemsProviderResult.From(items, (int)total);
            }
            catch (OperationCanceledException)
            {
                return GridItemsProviderResult.From(new List<ProductDto>(), 0);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Failed to load products");
                return GridItemsProviderResult.From(new List<ProductDto>(), 0);
            }
        };
    }
}
