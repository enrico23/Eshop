@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1"
         style="background-color: rgba(0,0,0,.5);" 
         @onclick="Close">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                <div class="modal-footer">
                    @if(ShowCancel)
                    {
                        <button class="@CancelButtonCssClass" @onclick="Close">@CancelText</button>
                    }

                    @if (ShowConfirm)
                    {
                        <button class="@ConfirmButtonCssClass" @onclick="Confirm">@ConfirmText</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter] public string Title { get; set; } = "Modal";

    [Parameter] public bool ShowCancel { get; set; } = true;
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string CancelButtonCssClass { get; set; } = "btn";

    [Parameter] public bool ShowConfirm { get; set; } = true;
    [Parameter] public string ConfirmText { get; set; } = "OK";
    [Parameter] public string ConfirmButtonCssClass { get; set; } = "btn btn-danger";

    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task Close()
    {
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task Confirm()
    {
        if (OnConfirm.HasDelegate)
            await OnConfirm.InvokeAsync();
        await Close();
    }
}
