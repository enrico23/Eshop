# Normalize all text files to LF in the repo,
# while checking out CRLF on Windows machines.
* text=auto eol=lf

# Ensure C# and other code files always use LF
*.cs      text eol=lf
*.cshtml  text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
